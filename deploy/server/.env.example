# ============================================================================
#  服务器部署环境变量（复制为 .env 后逐项修改）
#  位置：deploy/server/.env        —— 该文件含密码，不要提交到代码库
# ============================================================================

# ---------- 发布版本 ----------
# local 仅用于本地检查；服务器上改为当前 Git 发布标签，例如 v1.0.0。
# 镜像名为 hz-delivery-server:<APP_VERSION>，每次发布换一个版本号。
APP_VERSION=local

# ---------- 对外端口 ----------
# 只开放 80；MySQL / Redis / 后端 API 端口不对校园网开放（见 docker-compose.yml）
WEB_PORT=80

# ---------- 数据库 ----------
# 【必改】强密码，建议 16 位以上随机串：openssl rand -base64 24
# 留空会使 Compose 配置校验失败，填写后再启动。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hz_delivery

# ---------- 业务参数 ----------
SLA_DAYS=10
DEFAULT_QUOTA=1
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=10
ADMIN_LOGIN_MAX_FAIL=5
ADMIN_LOGIN_LOCK_MINUTES=10
# 同源部署通常无需加入公网域名；仅填写确实需要跨域访问后台的来源
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
SMS_DAILY_LIMIT=10

# C 端登录方式：
#   sms  = 手机号 + 短信验证码（需先配置下方 SMS_AUTH_PROVIDER）
#   name = 手机号 + 姓名核验（仅演示环境，不安全，勿在生产使用：
#          姓名是公开信息，拿到同事手机号即可冒领）
LOGIN_MODE=sms

# ---------- 登录验证码认证（阿里云号码认证 PNVS） ----------
# local 兼容旧通道（用 SMS_PROVIDER）；正式启用时改为 aliyun-pnvs 并填写以下四项。
# aliyun-pnvs 配置不完整会阻止后端启动，不会回退到演示验证码。
SMS_AUTH_PROVIDER=local
SMS_AUTH_TEST_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
ALIYUN_PNVS_SCHEME_NAME=hz-client-login

# ---------- 发货超时预警短信 ----------
# 留空则只落库到 t_sla_alert、后台 SLA 页可看，不发送短信
SLA_ALERT_PHONE=
SLA_ALERT_CRON=0 30 9 * * ?

# ---------- 真实物流轨迹（快递100企业版） ----------
# 开通“实时快递查询”后填写；密钥不要提交到代码库。
LOGISTICS_PROVIDER=disabled
LOGISTICS_QUERY_ON_ACCESS=true
LOGISTICS_VALIDATE_ON_SHIP=true
LOGISTICS_MIN_INTERVAL_MINUTES=30
LOGISTICS_BATCH_SIZE=50
LOGISTICS_SYNC_CRON=0 */30 * * * ?
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_BASE_URL=https://poll.kuaidi100.com/poll/query.do
KUAIDI100_CONNECT_TIMEOUT=5
KUAIDI100_READ_TIMEOUT=10

# ---------- 短信通道 ----------
# mock = 不真实发送（演示/联调用）；hbu = 河北大学统一短信平台（真实发送）
SMS_PROVIDER=mock
SMS_TEST_ENABLED=false
# 切到 hbu 时填写（不要提交到代码库）：
SMS_HBU_BASE_URL=http://sim.hbu.edu.cn/sms-hbu/api
SMS_HBU_CID=7
SMS_HBU_KEY=
SMS_HBU_MODEL=yzmmb
SMS_HBU_TIME_MINUTES=5

# 演示固定验证码：仅 SMS_AUTH_PROVIDER=local 且 SMS_PROVIDER=mock 时生效。
MOCK_SMS_CODE=

# ---------- 后台初始账号 ----------
# 【必改】应用启动时补齐缺失的 admin / operator / viewer，已有账号密码不受影响。
# 修改此项不会重置已有账号；密码通过后台修改。
ADMIN_INIT_PASSWORD=

# ---------- JVM ----------
JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:+UseG1GC -Dfile.encoding=UTF-8
