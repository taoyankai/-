# ============================================================================
#  服务器部署环境变量（复制为 .env 后逐项修改）
#  位置：deploy/server/.env        —— 该文件含密码，不要提交到代码库
# ============================================================================

# ---------- 对外端口 ----------
# 只开放 80；MySQL / Redis / 后端 API 端口不对校园网开放（见 docker-compose.yml）
WEB_PORT=80

# ---------- 数据库 ----------
# 【必改】强密码，建议 16 位以上随机串：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_DATABASE=hz_delivery

# ---------- 业务参数 ----------
SLA_DAYS=10
DEFAULT_QUOTA=1
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=10
SMS_DAILY_LIMIT=10

# C 端登录方式：
#   sms  = 手机号 + 短信验证码（默认；需先配好短信通道 SMS_PROVIDER=hbu）
#   name = 手机号 + 姓名核验（仅演示环境，不安全，勿在生产使用：
#          姓名是公开信息，拿到同事手机号即可冒领）
LOGIN_MODE=sms

# ---------- 发货超时预警短信 ----------
# 留空则只落库到 t_sla_alert、后台 SLA 页可看，不发送短信
SLA_ALERT_PHONE=
SLA_ALERT_CRON=0 30 9 * * ?

# ---------- 短信通道 ----------
# mock = 不真实发送（演示/联调用）；hbu = 河北大学统一短信平台（真实发送）
SMS_PROVIDER=mock
SMS_TEST_ENABLED=false
# 切到 hbu 时填写（不要提交到代码库）：
SMS_HBU_BASE_URL=http://sim.hbu.edu.cn/sms-hbu/api
SMS_HBU_CID=7
SMS_HBU_KEY=
SMS_HBU_MODEL=yzmmb
SMS_HBU_TIME_MINUTES=5

# 演示固定验证码：仅在 SMS_PROVIDER=mock 时生效。服务器上留空，避免"固定验证码"被误用
MOCK_SMS_CODE=

# ---------- 后台初始账号 ----------
# 【必改】首次启动（t_admin 为空）时用它创建 admin / operator / viewer
ADMIN_INIT_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---------- JVM ----------
JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:+UseG1GC -Dfile.encoding=UTF-8
