<!--pages/track/track.wxml-->
<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">运单号</view>
      <input
        class="input"
        placeholder="请输入快递单号，如 SF1345678901234"
        placeholder-class="placeholder"
        value="{{no}}"
        bindinput="onInput"
        bindconfirm="query"
        confirm-type="search" />
    </view>
    <button class="btn" disabled="{{loading}}" bindtap="query">
      {{loading ? '查询中…' : '查询物流进度'}}
    </button>
    <view class="hint mt">
      仅可查询本人订单的物流进度；运单号可在「我的订单」详情中找到。
    </view>
  </view>

  <view class="err" wx:if="{{err}}">{{err}}</view>

  <block wx:if="{{result}}">
    <view class="card">
      <view class="card-hd">
        <text class="ttl">{{result.statusName}}</text>
        <text class="tag tag-brand">{{result.carrierName}}</text>
      </view>
      <view class="row"><text class="k">运单号</text><text class="v">{{result.waybillNo}}</text></view>
      <view class="row">
        <text class="k">收货地址</text>
        <text class="v">{{result.province}}{{result.city}}{{result.district}}{{result.detail}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{result.traces.length}}">
      <view class="card-hd"><text class="ttl">物流轨迹</text></view>
      <view class="tl" wx:for="{{result.traces}}" wx:key="id">
        <view class="tl-dot {{index === 0 ? 'on' : ''}}"></view>
        <view class="tl-body">
          <view class="tl-desc {{index === 0 ? 'on' : ''}}">{{item.desc}}</view>
          <view class="hint">{{item.timeText}}</view>
        </view>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="hint">
        商家已发货，正在等待承运商揽收，稍后将有轨迹更新。如需了解配送情况，
        可拨打承运商客服电话咨询。
      </view>
    </view>
  </block>

  <view class="card" wx:if="{{myWaybills.length}}">
    <view class="card-hd">
      <text class="ttl">我的运单</text>
      <text class="hint">点击直接查询</text>
    </view>
    <view
      class="wb"
      wx:for="{{myWaybills}}"
      wx:key="waybillNo"
      bindtap="pick"
      data-no="{{item.waybillNo}}">
      <view style="flex:1;margin-right:16rpx">
        <view class="wb-no">{{item.carrierName}} · {{item.waybillNo}}</view>
        <view class="hint">{{item.packageName}}</view>
      </view>
      <text class="tag {{item.tagCls}}">{{item.statusName}}</text>
    </view>
  </view>
</view>
