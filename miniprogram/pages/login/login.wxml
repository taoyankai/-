<!--pages/login/login.wxml-->
<view class="page">
  <view class="brand">
    <view class="brand-logo">华中</view>
    <view class="brand-name">华中商贸配送中心</view>
    <view class="brand-sub">教职工慰问品选购与配送信息登记</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">手机号</view>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入本人手机号"
        placeholder-class="placeholder"
        value="{{phone}}"
        bindinput="onPhone" />
    </view>

    <view class="field" wx:if="{{needName}}">
      <view class="field-label">姓名</view>
      <input
        class="input"
        maxlength="20"
        placeholder="请输入本人真实姓名"
        placeholder-class="placeholder"
        value="{{name}}"
        bindinput="onName" />
    </view>

    <view class="field" wx:if="{{needCode}}">
      <view class="field-label">短信验证码</view>
      <view style="display:flex;gap:16rpx">
        <input
          class="input"
          style="flex:1"
          type="number"
          maxlength="6"
          placeholder="请输入 6 位验证码"
          placeholder-class="placeholder"
          value="{{code}}"
          bindinput="onCode" />
        <view
          class="code-btn {{counting ? 'off' : ''}}"
          bindtap="sendCode">{{codeText}}</view>
      </view>
    </view>

    <view class="hint" style="margin-top:8rpx">
      仅限本次慰问品领取名单内的教职工登录。系统将比对发放名单，
      若提示不在名单中，请联系所在单位工会核实。
    </view>

    <view class="err" wx:if="{{err}}">{{err}}</view>

    <button class="btn mt" disabled="{{submitting}}" bindtap="submit">
      {{submitting ? '核验中…' : '核验身份并登录'}}
    </button>
  </view>

  <view class="hint" wx:if="{{showDemo}}">
    演示提示：可用 <text style="color:#C93B32">13900139003</text>（刘嘉怡，未领取）
    体验完整领取流程，或用 <text style="color:#C93B32">13800138000</text>（张明远，已领取）
    查看订单与物流轨迹。
  </view>
</view>
