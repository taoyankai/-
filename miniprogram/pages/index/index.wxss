/* pages/index/index.wxss */
.hero {
  padding: 26rpx 8rpx 34rpx;
}
.hero-t {
  font-size: 38rpx;
  font-weight: 500;
}
.hero-s {
  font-size: 25rpx;
  color: #8A8A90;
  margin-top: 8rpx;
}
.u-name {
  font-size: 32rpx;
  font-weight: 500;
}

/* 主行动卡：品牌红底 */
.cta {
  background: #C93B32;
}
.cta-t {
  font-size: 33rpx;
  font-weight: 500;
  color: #222;
}
.cta-s {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 10rpx;
}
.cta-a {
  font-size: 26rpx;
  color: #C93B32;
  margin-top: 20rpx;
}
.cta .cta-t,
.cta .cta-a {
  color: #fff;
}
.cta .cta-s {
  color: rgba(255, 255, 255, 0.82);
}

/* 三宫格入口 */
.grid {
  display: flex;
  margin-bottom: 20rpx;
}
.gitem {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  margin-right: 16rpx;
}
.gitem:last-child {
  margin-right: 0;
}
.g-t {
  font-size: 28rpx;
  font-weight: 500;
}
.g-s {
  font-size: 22rpx;
  color: #8A8A90;
  margin-top: 8rpx;
}
