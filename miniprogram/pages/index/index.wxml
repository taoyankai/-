<!--pages/index/index.wxml-->
<view class="page">
  <view class="hero">
    <view class="hero-t">华中商贸配送中心</view>
    <view class="hero-s">教职工慰问品选购与配送信息登记</view>
  </view>

  <!-- 加载中：给出明确反馈，避免"看起来是空白页" -->
  <view class="card" wx:if="{{loading}}">
    <view class="cta-t">正在加载您的领取信息…</view>
    <view class="cta-s">首次打开可能需要几秒，请稍候</view>
  </view>

  <!-- 加载失败：把原因留在页面上，并给出重试入口 -->
  <view class="card" wx:if="{{!loading && errMsg}}">
    <view class="cta-t">领取信息加载失败</view>
    <view class="cta-s">{{errMsg}}</view>
    <view class="cta-a" bindtap="retry">点击重试 ›</view>
  </view>

  <view class="card" wx:if="{{profile}}">
    <view class="between">
      <view style="flex:1">
        <view class="u-name">{{profile.name}}</view>
        <view class="hint">{{profile.org}} · {{profile.dept}}</view>
      </view>
      <text class="tag {{canClaim ? 'tag-brand' : 'tag-gray'}}">{{canClaim ? '可领取' : '已领取'}}</text>
    </view>
    <view class="divider"></view>
    <view class="row"><text class="k">可领取份数</text><text class="v">{{profile.quota}} 份</text></view>
    <view class="row"><text class="k">已领取份数</text><text class="v">{{profile.used}} 份</text></view>
  </view>

  <view class="card cta" wx:if="{{profile && canClaim}}" bindtap="goPackages">
    <view class="cta-t">选择慰问品套餐</view>
    <view class="cta-s">每人限领 1 份，提交配送信息后 10 日内发货</view>
    <view class="cta-a">立即选择 ›</view>
  </view>
  <view class="card" wx:elif="{{profile}}">
    <view class="cta-t">您已提交领取信息</view>
    <view class="cta-s">可在「我的订单」查看配送信息与物流进度</view>
  </view>

  <view class="grid">
    <view class="gitem" bindtap="goOrders">
      <view class="g-t">我的订单</view>
      <view class="g-s">配送信息与状态</view>
    </view>
    <view class="gitem" bindtap="goTrack">
      <view class="g-t">物流查询</view>
      <view class="g-s">按运单号查进度</view>
    </view>
    <view class="gitem" bindtap="goMine">
      <view class="g-t">我的</view>
      <view class="g-s">账号与说明</view>
    </view>
  </view>

  <view class="card">
    <view class="card-hd"><text class="ttl">配送承诺</text></view>
    <view class="row"><text class="k">发货时限</text><text class="v">收到配送信息后 10 日内</text></view>
    <view class="row"><text class="k">配送方式</text><text class="v">快递送货上门（上楼入户）</text></view>
    <view class="row"><text class="k">代收点</text><text class="v">未经您允许不投放代收点</text></view>
    <view class="row"><text class="k">费用</text><text class="v">全国包邮，无需支付任何费用</text></view>
  </view>

  <block wx:if="{{notices.length}}">
    <view class="card" wx:for="{{notices}}" wx:key="id">
      <view class="card-hd">
        <text class="ttl">{{item.title}}</text>
        <text class="tag tag-gray">{{item.typeName}}</text>
      </view>
      <view class="hint">{{item.content}}</view>
    </view>
  </block>
</view>
