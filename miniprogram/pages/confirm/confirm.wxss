/* pages/confirm/confirm.wxss */
.notice {
  background: #FDF3E3;
  color: #D98A18;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  margin-bottom: 20rpx;
}
.pkg-name {
  font-size: 32rpx;
  font-weight: 500;
}

/* 承运商单选 */
.carrier {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F5F6F8;
}
.carrier:last-child {
  border-bottom: none;
}
.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D8D9DD;
  margin-right: 22rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.carrier.on .radio {
  border-color: #C93B32;
  background: #C93B32;
  box-shadow: inset 0 0 0 7rpx #fff;
}
.c-name {
  font-size: 29rpx;
}

/* 承诺区 */
.pi {
  font-size: 25rpx;
  color: #6A6A70;
  line-height: 1.9;
  padding-left: 26rpx;
  position: relative;
}
.pi::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 18rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #C8912F;
}
.pi .b {
  color: #C93B32;
  font-weight: 500;
}
