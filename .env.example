# ============================================================================
#  华中商贸配送中心 · 环境变量模版
#  使用方式：复制为 .env 后按需修改；.env 不要提交到代码仓库
# ============================================================================

# ---------- 对外端口 ----------
WEB_PORT=80                 # 前台入口（H5 + 后台 + API 统一入口）
API_PORT=8080               # 仅调试用，直接访问后端

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=hz_root_2026
MYSQL_DATABASE=hz_delivery
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 业务参数 ----------
SLA_DAYS=10                 # 承诺发货天数（招标要求：10 日内发货）
DEFAULT_QUOTA=1             # 每人可领份数（本项目：每人只能选择一个套餐）

LOGIN_MODE=sms              # C 端登录方式：sms=手机号+短信验证码（默认）；name=手机号+姓名核验（仅演示，不安全）
LOGIN_MAX_FAIL=5            # 同一手机号连续核验失败上限，达到即临时锁定
LOGIN_LOCK_MINUTES=10       # 锁定时长（分钟），同时作为失败计数窗口
SMS_DAILY_LIMIT=10          # 同一手机号每日验证码发送上限（防对名单内号码轮流轰炸）

SLA_ALERT_PHONE=            # 发货超时预警短信接收号码（多个用英文逗号分隔）；留空则只落库不发短信
SLA_ALERT_CRON=0 30 9 * * ? # 预警扫描时间，默认每日 09:30

MOCK_SMS_CODE=123456        # 演示固定验证码，仅在 SMS_PROVIDER=mock 时生效
# 短信发送通道：mock=演示不真实发送；hbu=河北大学统一短信服务平台（真实发送）；aliyun=阿里云骨架
SMS_PROVIDER=mock
SMS_TEST_ENABLED=false      # 后台「短信通道自检」接口开关，排查完请改回 false

# ---------- 河北大学统一短信服务平台（SMS_PROVIDER=hbu 时生效）----------
SMS_HBU_BASE_URL=http://sim.hbu.edu.cn/sms-hbu/api
SMS_HBU_CID=7
SMS_HBU_KEY=                # 接口密钥，请向平台管理员索取，勿提交到代码库
SMS_HBU_MODEL=yzmmb         # 验证码模板名
SMS_HBU_TIME_MINUTES=5      # 模板中验证码有效期（分钟）

# ---------- 后台初始账号密码 ----------
# 仅在首次启动、管理员表为空时生效，登录后请立即修改
ADMIN_INIT_PASSWORD=hz@2026

# ---------- JVM ----------
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Dfile.encoding=UTF-8
